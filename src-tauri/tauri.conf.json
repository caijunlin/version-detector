{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "version-detector",
  "version": "1.0.0",
  "identifier": "com.caijunlin.versiondetector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:18888",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "version-detector",
        "width": 550,
        "height": 400,
        "minWidth": 400,
        "minHeight": 350,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
